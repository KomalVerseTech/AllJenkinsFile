pipeline {

    agent any

    stages {

        stage('Matrix Build') {

            matrix {

                axes {

                    axis {
                        name 'JAVA_VERSION'
                        values '17', '21'
                    }

                    axis {
                        name 'ENVIRONMENT'
                        values 'DEV', 'QA', 'PROD'
                    }

                }

                excludes {

                    exclude {

                        axis {
                            name 'JAVA_VERSION'
                            values '17'
                        }

                        axis {
                            name 'ENVIRONMENT'
                            values 'PROD'
                        }

                    }

                }

                stages {

                    stage('Build') {

                        steps {

                            echo "================================"

                            echo "Java Version : ${JAVA_VERSION}"

                            echo "Environment  : ${ENVIRONMENT}"

                            echo "Building Application..."

                            echo "================================"

                            sleep(time:5, unit:'SECONDS')

                        }

                    }

                }

            }

        }

    }

