pipeline {

    agent any

    stages {

        stage('Matrix Build') {

            matrix {

                axes {

                    axis {

                        name 'JAVA_VERSION'

                        values '17','21'

                    }

                    axis {

                        name 'ENVIRONMENT'

                        values 'DEV','QA'

                    }

                }

                stages {

                    stage('Build') {

                        steps {

                            echo "Java Version : ${JAVA_VERSION}"

                            echo "Environment : ${ENVIRONMENT}"

                        }

                    }

                }

            }

        }

    }

}









