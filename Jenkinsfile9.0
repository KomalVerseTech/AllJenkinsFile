# First Parameter String
pipeline {
  agent any
  parameters {

    string(
      name: 'STUDENT_NAME',
      defualtValue: 'Komal',
      description: 'Enter Student Name'
      }
      }
      stages {
        stage('Print Parameter') {
          steps {
            echo "Student Name = ${params.STUDENT_NAME}"
          }
        }
      }
      }

# Multiple Parameters
pipeline {
agent any
parameters {

  string(
      name: 'NAME',
      defaultValue: 'Komal',
      description: 'Enter Name'
)
  string(
      name: 'COURSE',
      defaultValue: 'Jenkins',
      description: 'Enter Course'
)
}
    stages {
    stage('Student Details') {
      steps {
          echo "Name : ${params.NAME}"
          echo "Course : ${params.COURSE}"
}
}
}
}

#Choice Parameter
pipeline {
  agent any 
  parameters {
    choice(
      name: 'ENVIRONMENT',
    choices: [
        'DEV',
        'QA',
        'PROD',
        'TEST'
],
    description: 'Select Environment'
)
}
  stages {
    stage('Deploy') {
steps {
      echo "Deploying to ${params.ENVIRONMENT}"
}
}
}
}
# Boolean Parameter
pipeline {
  agent any

  parameters {
    booleanParam(
        name: 'DEPLOY',
        defaultValue: true,
        description: 'Deploy Application?'
)
}
stages {
    stage('Decision') {
steps {
  echo "Deploy = ${params.DEPLOY}"
}
}
}
}

# Real Flow
pipeline {
  agent any
  parameters {
    string(
      name: 'APPLICATION',
      defaultValue: 'StudentApp',
      description: 'Application Name'
)
choice(
    name: 'ENV',
    choices: ['DEV', 'QA', 'PROD'],
    description: 'Select Environament'
)
booleanParam(
  name: 'Deploy',
  defaultValue: true,
  description: 'Deploy?'
)
}
stages {
  stage('Build Info') {
steps {
    echo "Application : ${params.APPLICATION}"
    echo "Environment : ${params.ENV}"
    echo "Deploy : ${params.DEPLOY}"
}
}
}
}
