#Post Block in Jenkins Pipeline
A Post block runs after all stages finish
pipeline {
	agent any
	stages {
		stage('Build') {
			steps {
				echo "Building Application..."
}
}
}
post {
	success {
		echo "Build Completed Successfully."
}
}
}

#Failure Block
pipeline {
	agent any
	stages {
		stage('Test') {
			steps {
				sh "exit 1"
}
}
}
post {
	failure {
		echo "Build Failed."
}
}
}

# Complete Flow
pipeline {
	agent any
	stages {
		stage('Compile') {
			steps {
				echo "Compiling.."
}
}
}
post {
success {
	echo "Application Built Successfully."
}
failure {
	echo "Application Build Failed."
}
always {
	echo "Pipeline Finished."
}
}
}

# Jenkins Build Status
- Success = Everything passed
- Failure = Build/Test failed
- Unstable = Build Succeeded but some tests failed
- Aborted = User stopped the build

# When Condition in Jenkins Pipeline
when decides whether a stage execute or not
pipeline {
	agent any
	parameters {
		booleanParam(
			name: 'DEPLOY',
			defaultValue: true,
			description: 'Deploy Application?'
)
}
stages {
	stage('Build') {
		steps {
			echo "Building Application ..."
}
}
stage('Deploy') {
 when {
	expression {
		return params.DEPLOY
}
}
steps {
	echo "Deploying Application..."
}
}
}
}

#Another Example
pipeline {
	agent any
	parameters {
		choice(
			name: 'ENV',
			choices: [
				'DEV',
				'QA',
				'PROD'
				],
			description: 'Select Environment'
			)
	}
	stages {
		stage('Build') {
			steps {
				echo "Building..."
			}
		}
		stage('Deploy') {
			when {
				expression {
					return params.ENV == "PROD"
				}
			}
			steps {
				echo "Deploying to Production"
			}
		}
	}
}
