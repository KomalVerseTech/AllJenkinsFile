#Post Block in Jenkins Pipeline
A Post block runs after all stages finish
pipeline {
	agent any
	stages {
		stage('Build') {
			steps {
				echo "Building Application..."
}
}
}
post {
	success {
		echo "Build Completed Successfully."
}
}
}

#Failure Block
pipeline {
	agent any
	stages {
		stage('Test') {
			steps {
				sh "exit 1"
}
}
}
post {
	failure {
		echo "Build Failed."
}
}
}

# Complete Flow
pipeline {
	agent any
	stages {
